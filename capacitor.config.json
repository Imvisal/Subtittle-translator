{
  "appId": "com.visal.sinsubz",
  "appName": "SinSubz",
  "webDir": "www",
  "backgroundColor": "#07080d",
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_sinsubz",
      "iconColor": "#7c7cff"
    },
    "FirebaseAuthentication": {
      "providers": [
        "google.com"
      ],
      "skipNativeAuth": false
    }
  }
}
